<Project Sdk="Microsoft.NET.Sdk">

  <!--
    L1/L2 test runner. Zero NuGet dependencies on purpose: this machine cannot reach
    nuget.org, and the requirement document's L1 layer only needs deterministic assertions
    over pure functions (REQ-TEST-01..03).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>HDBF.Tests</AssemblyName>
    <RootNamespace>HDBF.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    ART-03 L1 data contract (ArtModelContractTests) reads the REAL shipped data/ tree - the eight
    blueprints, their .timbermesh assets, the tier icons and the art document. Build output lives
    under $env:TEMP, so the repository root is baked into this assembly as metadata; the tests fall
    over with an explicit message if data/ cannot be found under it. This is plain file I/O, not a
    game/Unity reference (REQ-TEST-03): no Timberborn or Unity assembly is added by this ItemGroup.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="HdbfRepoRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HDBF.Core\HDBF.Core.csproj" />
  </ItemGroup>

  <!--
    The UI localization key table is pure C# (a static class of string constants) even though it
    lives in HDBF.UI. Linking it lets L1 prove that the keys the panel formats exist in all three
    shipped CSVs without referencing the game-facing HDBF.UI assembly (REQ-TEST-03).
  -->
  <ItemGroup>
    <Compile Include="..\..\src\HDBF.UI\Localization\HdbfUiLocKeys.cs" Link="Linked\HdbfUiLocKeys.cs" />
  </ItemGroup>

  <!--
    V2-UI-01 panel read model: the HdbfIndoor*.cs files are the game-free half of the indoor panel
    (localized read model + pure formatting/mapping + the duck-typed query bridge). They reference
    HDBF.Core and HdbfUiLocKeys only, so linking them lets V2PanelContractTests drive the REAL
    panel mapping (every snapshot field, failure reason, "—" rule) without loading Timberborn.
    The game-dependent fragment partials stay out of this assembly (REQ-V2-TEST-01).
  -->
  <ItemGroup>
    <Compile Include="..\..\src\HDBF.UI\Panels\HdbfIndoor*.cs" Link="Linked\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    V2-GAMEPLAY-01 source contract: the controller and its persistence/crop/workplace support
    reference Timberborn types and cannot be compiled into this game-free L1 assembly, so they are
    embedded as text. V2GameplayContractTests pins the v2 Core calls and the absence of the removed
    v1 world-plot/planting chain (REQ-V2-CORE-03, REQ-V2-MAINT-02/03, REQ-V2-SAFE-01).
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\HdbfBoxFarmController*.cs"
                      Exclude="..\..\src\HDBF.Gameplay\Components\HdbfBoxFarmController.Diagnostics.cs">
      <LogicalName>HDBF.Tests.Source.Controller.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <!-- Release-gate G-08 keeps its stable resource name for the compile-time diagnostics source. -->
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\HdbfBoxFarmController.Diagnostics.cs">
      <LogicalName>HDBF.Tests.Source.Diagnostics.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\GameCropCatalog*.cs">
      <LogicalName>HDBF.Tests.Source.Catalog.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Persistence\IndoorEntitySaveBridge*.cs">
      <LogicalName>HDBF.Tests.Source.Bridge.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Farming\IndoorFarmWorkplaceBehavior.cs">
      <LogicalName>HDBF.Tests.Source.IndoorFarmWorkplaceBehavior.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\IndoorInventorySink.cs">
      <LogicalName>HDBF.Tests.Source.IndoorInventorySink.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\IndoorMaintenanceMaterialSource.cs">
      <LogicalName>HDBF.Tests.Source.IndoorMaintenanceMaterialSource.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\ReadOnlyGrowthRateProvider.cs">
      <LogicalName>HDBF.Tests.Source.ReadOnlyGrowthRateProvider.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\HdbfGameConfigurator.cs">
      <LogicalName>HDBF.Tests.Source.HdbfGameConfigurator.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\HdbfFarmCommandService.cs">
      <LogicalName>HDBF.Tests.Source.HdbfFarmCommandService.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\HdbfFarmQueryService.cs">
      <LogicalName>HDBF.Tests.Source.HdbfFarmQueryService.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Gameplay\Components\HdbfGameplayContracts.cs">
      <LogicalName>HDBF.Tests.Source.HdbfGameplayContracts.cs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    ADR-009 growth patch source contract: HDBF.Integration references Timberborn assemblies and
    cannot be loaded into this game-free test assembly, so the shipped patch sources are embedded
    as text. `GrowthMultiplierPatchTests` pins the single-Postfix / no-IL-rewrite / one-Harmony-
    instance contract and the feature-switch wiring; deleting or duplicating the patch fails L1.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\HDBF.Integration\Harmony\HdbfPatchCatalog.cs">
      <LogicalName>HDBF.Tests.Source.GrowthPatchCatalog.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Integration\Harmony\BoxFarmGrowthPatch.cs">
      <LogicalName>HDBF.Tests.Source.GrowthPatch.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Integration\Harmony\HdbfHarmonyInstaller.cs">
      <LogicalName>HDBF.Tests.Source.HarmonyInstaller.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Integration\Harmony\HarmonyBootstrap.cs">
      <LogicalName>HDBF.Tests.Source.HarmonyBootstrap.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Integration\Harmony\HdbfGrowthPatchBridge.cs">
      <LogicalName>HDBF.Tests.Source.GrowthPatchBridge.cs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    REL-01 release-gate contract resources. The gate manifest, the single dev-diagnostics
    build property and the shipped data config are embedded so ReleaseGateContractTests can
    assert that build.ps1's gate list still matches the shipped code/data (a drifted gate list
    fails L1, not just a manual review). No game assembly is referenced.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\release\release-gates.json">
      <LogicalName>HDBF.Tests.Release.release-gates.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\Directory.Build.props">
      <LogicalName>HDBF.Tests.Release.Directory.Build.props</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\data\HDBF_Config.json">
      <LogicalName>HDBF.Tests.Release.HDBF_Config.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    The three shipped localization files are embedded as test resources so the key-set / label-length
    contract is checked against exactly the data that ships, from any working directory.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\Localizations\enUS.csv">
      <LogicalName>HDBF.Tests.Localizations.enUS.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\data\Localizations\zhCN.csv">
      <LogicalName>HDBF.Tests.Localizations.zhCN.csv</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\data\Localizations\zhTW.csv">
      <LogicalName>HDBF.Tests.Localizations.zhTW.csv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    V2-INTEG-01 indoor adaptor host source contract: HDBF.Integration references Timberborn and
    Bindito assemblies and cannot be loaded into this game-free test assembly, so the v2 host,
    the Timber Pipes water source and the reflection binding are embedded as text.
    V2AdapterHostContractTests pins the Core contracts, the degradation paths, the verified real
    anchors and the "no Harmony / no v1 plot calls / no per-frame water" rules (REQ-V2-WATER-02,
    REQ-V2-COMPAT-01/02, REQ-V2-SAFE-05).
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\HDBF.Integration\Adapters\IndoorAdapterHost.cs">
      <LogicalName>HDBF.Tests.Source.IndoorAdapterHost.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Integration\Adapters\TimberPipesWaterSource.cs">
      <LogicalName>HDBF.Tests.Source.TimberPipesWaterSource.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Integration\Adapters\TimberPipesWaterBinding.cs">
      <LogicalName>HDBF.Tests.Source.TimberPipesWaterBinding.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\src\HDBF.Core\Compat\IIndoorAdapterHost.cs">
      <LogicalName>HDBF.Tests.Source.IIndoorAdapterHost.cs</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
