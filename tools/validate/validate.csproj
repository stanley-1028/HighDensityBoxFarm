<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HDBF data validator. Verifies the shippable data\ folder against the installed game
    assemblies and the mod's own built spec assembly:

      * manifest.json fields;
      * every top-level blueprint spec name resolves to a real public ComponentSpec
        subclass in the game, or to a mod spec (HdbfBoxFarmSpec) in a built HDBF.* assembly;
      * blueprint field names / enum values exist in the game metadata;
      * every localization key used in JSON exists in both enUS.csv and zhCN.csv, and the
        two files have identical key sets and placeholders;
      * HDBF_Config.json matches the shape read by HDBF.Core.Config.HdbfConfigCodec;
      * the four BoxFarm blueprints, template collections, icons and placeholder notes are
        self-consistent.

    No ProjectReference and no NuGet package is used: Mono.Cecil is referenced from the local
    package cache, exactly like tools/ApiIndex (this machine is offline; see API_FACTS.md §6).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>HdbfValidate</AssemblyName>
    <RootNamespace>HDBF.Tools.Validate</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(UserProfile)\.nuget\packages\mono.cecil\0.11.5\lib\netstandard2.0\Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
