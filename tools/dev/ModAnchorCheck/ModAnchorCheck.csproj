<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev-only anchor verifier. It reads the *installed* third-party DLL metadata directly from the
    Steam Workshop folder (nothing is copied into this repository) and re-proves every anchor in
    HDBF.Core.Compat.CompatAnchorTable: assembly identity, type full name, member name, parameter
    types and return type.

    Zero NuGet dependencies: it uses System.Reflection.Metadata from the shared framework, the
    same ground-truth approach documented for API_FACTS.md. Usage is documented in
    docs/workstreams/compat-01-adapters.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ModAnchorCheck</AssemblyName>
    <RootNamespace>HDBF.Tools.ModAnchorCheck</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\HDBF.Core\HDBF.Core.csproj" />
  </ItemGroup>

</Project>
