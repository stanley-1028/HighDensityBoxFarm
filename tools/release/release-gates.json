{
  "manifestVersion": 1,
  "description": "REL-01 release-gate contract. build.ps1 enforces every value below; HDBF.Tests.ReleaseGateContractTests asserts the same values against the shipped sources/data so the gate list cannot drift away from the code without a red L1 suite.",
  "gateIds": ["G-01", "G-02", "G-03", "G-04", "G-05", "G-06", "G-07", "G-08", "G-09"],

  "requiredAssemblies": [
    "HDBF.Core",
    "HDBF.Persistence",
    "HDBF.Gameplay",
    "HDBF.Integration",
    "HDBF.UI"
  ],
  "allowedStagedExtensions": [".dll", ".json", ".csv", ".png", ".md", ".txt", ".timbermesh"],
  "forbiddenStagedPatterns": [
    "*test*",
    "*debug*",
    "*cheat*",
    "*diag*",
    "*dev*",
    "*.pdb",
    "*.xml",
    "*.deps.json",
    "*.runtimeconfig.json"
  ],
  "forbiddenConfigKeys": [
    "debug",
    "debugPanel",
    "devDiagnostics",
    "cheat",
    "cheatPanel",
    "godMode",
    "unlockAll",
    "devCommands"
  ],

  "harmony": {
    "maxPatches": 0,
    "forbiddenSourceDirectory": "src/HDBF.Integration/Harmony",
    "stagedAssembly": "HDBF.Integration.dll",
    "forbiddenTokens": ["HarmonyLib", "HarmonyInstance", "[HarmonyPatch]", "Transpiler"],
    "sourceScanRoot": "src",
    "forbiddenSourceTokens": ["HarmonyLib", "HarmonyInstance", "[HarmonyPatch]", "ReportHarmonyPatchCount"],
    "nonzeroPatchCountPattern": "HarmonyPatchCount\\s*=\\s*[1-9]",
    "configFile": "data/HDBF_Config.json",
    "forbiddenConfigKeys": ["growthMultiplierPatch"],
    "reportField": "harmonyPatchCount",
    "compatReportSource": "src/HDBF.Core/Compat/CompatReport.cs"
  },

  "configContract": {
    "stagedFile": "HDBF_Config.json",
    "schemaVersion": 2,
    "schemaVersionKey": "configSchemaVersion",
    "requiredSections": ["features", "perf", "ui", "balance"],
    "forbiddenKeys": [
      "growthMultiplierPatch",
      "scanBudgetPerFrame",
      "scanIntervalSeconds",
      "irrigationSampleInterval",
      "cropVisibilityIntervalSeconds",
      "cropVisibilityCellsPerFrame",
      "warningAggregateTtlSeconds",
      "hideManagedCrops"
    ]
  },

  "compatReport": {
    "sourceFile": "src/HDBF.Core/Compat/CompatReport.cs",
    "formatVersion": 1,
    "fields": [
      "reportVersion",
      "modVersion",
      "gameVersion",
      "schemaVersion",
      "configSchemaVersion",
      "detectedMods",
      "enabledAdapters",
      "failedAdapters",
      "detectionSource",
      "detectionDurationMs",
      "harmonyPatchCount",
      "performanceMode",
      "lastError"
    ]
  },

  "localizations": {
    "stagedDirectory": "Localizations",
    "languages": ["enUS", "zhCN", "zhTW"],
    "requiredHeader": "ID,Text,Comment"
  },

  "testSeams": {
    "type": "TestHooks",
    "sourceFile": "src/HDBF.Integration/TestHooks.cs",
    "allowedAssemblyDirectory": "src/HDBF.Integration",
    "playerFacingEntryPoints": false
  },

  "l1": {
    "minTests": 480,
    "mustContain": "FAILED 0",
    "project": "tests/HDBF.Tests/HDBF.Tests.csproj"
  }
}
